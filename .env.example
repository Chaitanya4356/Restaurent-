# ==========================================
# Josh Restaurant Environment Variables
# ==========================================

# 1. Supabase Public Settings (Available to browser)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Supabase Server Secret (CRITICAL: NEVER COMMIT TO GIT OR EXPOSE TO BROWSER)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 3. Transactional Email (Resend)
# Found in: Resend Dashboard -> API Keys
RESEND_API_KEY=re_123456789_your_api_key
OWNER_NOTIFICATION_EMAIL=bchaitanya096@gmail.com

# 4. Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 5. Order tracking token secret (optional)
# Signs the private customer tracking links. If unset, the service-role key is
# used instead. Set it once per environment and never change it - rotating it
# invalidates every tracking link that has already been shared.
# TRACKING_TOKEN_SECRET=generate-a-long-random-string

# 5. Optional Payment Gateway (Phase 7 - Razorpay)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
